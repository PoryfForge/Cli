{
  "_comment": "收录清单：本库收了哪些 CLI、每个的能力从哪来、怎么采集。新增一个 CLI = 往 clis 里加一条记录，然后跑 bin/refresh <name>。脚本本身不用改。",
  "_scope": "只收厂商提供的 SaaS 能力型 CLI（有账号体系、调用有副作用、官方另有写给 Agent 的规则）。系统自带工具、包管理器、数据库客户端不在范围内。",
  "_fields": {
    "name": "注册名，对应 registry/<name>/",
    "command": "可执行文件名",
    "repo": "官方来源，用于溯源与 release 查询",
    "license": "许可证",
    "install": "官方安装方式（写进能力文档，方便读者自己装）",
    "scopeNote": "只有备注，不参与采集。用于记「这个条目的定位有存疑 / 覆盖面有缺口」，会随 clis.json 一起公开",
    "note": "采集前就已知的覆盖面缺口，会渲染进 CAPABILITY.md 的「采集说明」（读者看的是文档，不是本文件，所以这一类要落进文档）",
    "profile": "解析档，决定能力怎么写进文档。可选：lark / wecom / help-tree",
    "acquire.kind": "skill-repo（下载仓库源码解出 skills/）、release-bin（取官方发布的可执行文件跑 --help）或 local-bin（厂商安装器已装进 PATH）",
    "acquire.url": "下载地址。非 GitHub 托管时逐平台写全：{\"darwin-arm64\": \"https://…\"}。也可写单条字符串给所有平台共用",
    "acquire.asset": "归档内文件名，逐平台映射。占位符 {versionBare} 是裸版本号，{version} 是原样版本（GitHub tag 常带 v）",
    "acquire.archive": "压缩形态：zip / tar.gz / none（裸二进制）。不写则按 URL 后缀推断，推不出来会直接报错",
    "acquire.versionSource": "版本端点。GitHub 托管可省；其余写 {kind: url-json|url-text, url, path}",
    "acquire.binPattern": "归档内的可执行文件名带平台后缀（tencentads_darwin_arm64）时，用它匹配",
    "acquire.docs": "厂商另外写的 Agent 规则文档。不在发布包里，单独取源码：tarball + stripPrefix + extract，skill 指定哪份合并进能力文档"
  },
  "clis": [
    {
      "name": "feishu-cli",
      "title": "飞书 CLI",
      "command": "lark-cli",
      "repo": "https://github.com/larksuite/cli",
      "license": "MIT",
      "install": "npx @larksuite/cli@latest install",
      "homepage": "https://github.com/larksuite/cli",
      "acquire": {
        "kind": "skill-repo",
        "profile": "lark",
        "srcDir": ".cache/src/lark-cli",
        "ref": "main",
        "tarball": "https://codeload.github.com/larksuite/cli/tar.gz/refs/heads/main",
        "stripPrefix": "cli-main",
        "versionFrom": "package.json",
        "vendor": ["AGENTS.md", "README.zh.md"],
        "extract": [
          "skills",
          "affordance",
          "skill-template",
          "README.md",
          "README.zh.md",
          "AGENTS.md",
          "package.json"
        ]
      }
    },
    {
      "name": "wecom-cli",
      "title": "企业微信 CLI",
      "command": "wecom-cli",
      "repo": "https://github.com/WecomTeam/wecom-cli",
      "license": "MIT",
      "install": "npm install -g @wecom/cli",
      "homepage": "https://github.com/WecomTeam/wecom-cli",
      "acquire": {
        "kind": "skill-repo",
        "profile": "wecom",
        "srcDir": ".cache/src/wecom-cli",
        "ref": "main",
        "tarball": "https://codeload.github.com/WecomTeam/wecom-cli/tar.gz/refs/heads/main",
        "stripPrefix": "wecom-cli-main",
        "versionFrom": "package.json",
        "vendor": ["AGENTS.md", "docs/cli-reference.md", "docs/skills.md"],
        "extract": [
          "skills",
          "docs",
          "AGENTS.md",
          "README.md",
          "package.json",
          "CHANGELOG.md"
        ]
      }
    },
    {
      "name": "dreamina",
      "title": "即梦 CLI",
      "command": "dreamina",
      "repo": "https://jimeng.jianying.com/cli",
      "license": "厂商专有",
      "install": "curl -fsSL https://jimeng.jianying.com/cli | bash",
      "homepage": "https://jimeng.jianying.com/cli",
      "acquire": {
        "kind": "local-bin",
        "profile": "help-tree",
        "skill": "~/.dreamina_cli/dreamina/SKILL.md",
        "vendor": ["~/.dreamina_cli/dreamina/SKILL.md"],
        "scan": {
          "depth": 2,
          "max": 80,
          "desc": "即梦（Dreamina）官方 AIGC CLI：文生图 / 图生图 / 文生视频 / 图生视频 / 多模态参考，含账号、会话与任务管理"
