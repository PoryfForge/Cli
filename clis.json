        "scan": {
          "depth": 3,
          "max": 900,
          "desc": "WPS 365 官方 CLI：日历、消息、通讯录、邮箱、云文档、智能文档、智能表格、多维表、会议 9 大业务域，另含 api 兜底命令与 spec 管理"
        }
      }
    },
    {
      "name": "github-cli",
      "title": "GitHub CLI",
      "command": "gh",
      "repo": "https://github.com/cli/cli",
      "license": "MIT",
      "install": "brew install gh",
      "homepage": "https://cli.github.com",
      "scopeNote": "只收 GitHub 的 SaaS 协作能力（仓库 / PR / Issue / Actions / release / 搜索 / API…）。本机通用 git 命令仍不在收录范围内。",
      "note": "`gh` 的一部分子命令来自**本机安装的扩展**而非内置（最典型的是 `gh copilot`）。扩展装没装、版本不同，扫出来的树就会不一样，对照时以本机 `gh <命令> --help` 为准。",
      "acquire": {
        "kind": "release-bin",
        "profile": "help-tree",
        "binDir": ".cache/releases/github-cli",
        "binName": "gh",
        "version": "latest",
        "asset": {
          "darwin-arm64": "gh_{versionBare}_macOS_arm64.zip",
          "darwin-x64": "gh_{versionBare}_macOS_amd64.zip",
          "linux-arm64": "gh_{versionBare}_linux_arm64.tar.gz",
          "linux-x64": "gh_{versionBare}_linux_amd64.tar.gz",
          "win32-x64": "gh_{versionBare}_windows_amd64.zip"
        },
        "docs": {
          "srcDir": ".cache/src/github-cli-docs",
          "tarball": "https://codeload.github.com/cli/cli/tar.gz/refs/heads/trunk",
          "stripPrefix": "cli-trunk",
          "ref": "trunk",
          "extract": ["skills/gh/SKILL.md", "skills/gh-skill/SKILL.md", "AGENTS.md"],
          "skill": "skills/gh/SKILL.md"
        },
        "scan": {
          "depth": 2,
          "max": 700,
          "desc": "GitHub 官方 CLI：仓库 / Issue / PR / Actions 工作流 / release / 搜索 / gist / codespace / project 等协作能力，另含 gh api 直连 REST 与 GraphQL 的兜底入口"
        }
      }
    },
